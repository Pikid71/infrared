{
  "name": "My Codespace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.LiveServer"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "InfraRed",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm i",
  "postStartCommand": "npm start",
  "postAttachCommand": "gh codespace ports visibility 8000:public -c $CODESPACE_NAME"
}